{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "anime_checker",
  "version": "1.0.2",
  "identifier": "com.Mattisiek.animeChecker",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "anime_checker",
        "width": 800,
        "height": 600,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/Mattisiek/anime-checker/releases/latest/download/latest.json"
      ],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU0MUZFOTREREMzMkMzOTYKUldTV3d6TGNUZWtmNUxhRldSWHlTTkpISXlFbVNBZUY3V3h5UHA2N0NoNnNtWUZLZkg0SHBOalgK"
    }
  }
}